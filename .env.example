# Copy to .env.local and fill in. Never commit .env.local.
#
# This file IS committed. Never put a real key here — put it in .env.local,
# which is gitignored.

# Google Gemini API key. Server-side only — must never be exposed to the
# browser. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults are used when unset.
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Where journal data lives, relative to the project root.
# DATA_DIR=data
